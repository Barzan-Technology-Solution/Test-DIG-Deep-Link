<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <staticContent>
            <!-- Ensure JSON MIME type is allowed for assetlinks.json -->
            <remove fileExtension=".json" />
            <mimeMap fileExtension=".json" mimeType="application/json" />
            
            <!-- Allow extensionless files like apple-app-site-association -->
            <remove fileExtension="." />
            <mimeMap fileExtension="." mimeType="application/json" />
        </staticContent>
        <security>
            <requestFiltering>
                <!-- Allow hidden segments like .well-known -->
                <hiddenSegments>
                    <remove segment=".well-known" />
                </hiddenSegments>
            </requestFiltering>
        </security>
        <httpProtocol>
            <customHeaders>
                <add name="Access-Control-Allow-Origin" value="*" />
            </customHeaders>
        </httpProtocol>
    </system.webServer>
</configuration>
